# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8090

# Must match Angular's origin so Socket.io's CORS handshake succeeds
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---------------------------------------------------------------------------
# JWT — MUST be the exact same secret NexaERP backend uses (app.jwt.secret
# in application.properties / JWT_SECRET env var), otherwise token
# verification here will fail for every user.
# ---------------------------------------------------------------------------
JWT_SECRET=nexaerp-jwt-secret-key-2025-very-long-and-secure-string-minimum-256-bit

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=nexaerp.notifications
RABBITMQ_QUEUE=realtime-service.notifications
# Binding pattern: catches notification.invoice.posted, notification.payment.posted, etc.
RABBITMQ_ROUTING_KEY=notification.#

# ---------------------------------------------------------------------------
# Redis (presence tracking — who is currently connected)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
